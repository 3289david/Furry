# ============================================================================
# Mochi-Puff — Server Environment Variables (.env.example)
# Copy this file to .env for local development, or configure in Settings > Secrets
# ============================================================================

# Server Port (defaults to 3000)
PORT=3000

# Google Gemini API Key (server-side only; automatically injected in AI Studio)
# Used by /api/chat (gemini-3.1-flash-lite), /api/stt (gemini-3.5-transcribe),
# and /api/tts (gemini-3.8-flash-lite-tts)
GEMINI_API_KEY=

# Optional: Custom OpenAI-Compatible API Keys (server-side only)
OPENAI_API_KEY=
CUSTOM_API_KEY=

# Optional: Custom OpenAI-Compatible Endpoints & Models
CUSTOM_CHAT_BASE_URL=
CUSTOM_CHAT_MODEL=gpt-4o-mini
CUSTOM_STT_BASE_URL=
CUSTOM_STT_MODEL=whisper-1
CUSTOM_TTS_BASE_URL=
CUSTOM_TTS_MODEL=tts-1
