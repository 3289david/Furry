{
  "name": "fursim",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive 3D WebGL2/GPGPU fur physics and Marschner hair shading simulation for a stylized creature across studio, nature, and live AR camera environments.",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "[ -d node_modules/.bin ] || bun install || npm install",
    "dev": "node server.js --dev",
    "prebuild": "[ -d node_modules/.bin ] || bun install || npm install",
    "build": "vite build",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "lint": "tsc --noEmit",
    "start": "node server.js",
    "test": "node adversarial_assessor.js",
    "electron": "electron electron/main.cjs",
    "build:exe": "vite build && electron-builder --win portable nsis",
    "build:dmg": "vite build && electron-builder --mac dmg",
    "build:desktop": "vite build && electron-builder -w -m"
  },
  "build": {
    "appId": "com.mochipuff.app",
    "productName": "Mochi-Puff",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "icon.png",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png",
      "category": "Game"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.169.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
